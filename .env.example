# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Postgres --------------------------------------------------------------
# Locally this is the Homebrew server; in Coolify it is the private network
# address of the Postgres service.
DATABASE_URL=postgresql://localhost:5432/wardrobe

# TLS is off unless set. Leave empty when Postgres shares a private network with
# the app (the normal Coolify setup). Set to "require" whenever the connection
# leaves the host, or "no-verify" for a managed database with a self-signed
# certificate.
PGSSLMODE=

# --- Claude ----------------------------------------------------------------
# Leave unset locally if you are signed in with `ant auth login`; the SDK picks
# that profile up. Set it in Coolify.
ANTHROPIC_API_KEY=

# --- Files -----------------------------------------------------------------
# Photos go to a private Cloudflare R2 bucket when all four R2 settings are
# set (production, see the README), and to PHOTOS_DIR when none are (dev and
# the tests). Some but not all is an error, so photos never quietly land on
# the server's disk. The key needs Object Read & Write on this bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
PHOTOS_DIR=./data/photos

# --- Try-on ----------------------------------------------------------------
# OpenAI Images, only for a "See it on me" Malin taps (docs/plan.md 1.1).
OPENAI_API_KEY=

# --- Sign-in ---------------------------------------------------------------
# The one password for the deployed site. Leave empty locally and the app is
# open; set it in Coolify. Changing it signs every device out.
APP_PASSWORD=

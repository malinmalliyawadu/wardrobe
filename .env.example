# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Postgres --------------------------------------------------------------
# Locally this is the Homebrew server; in Coolify it is the private network
# address of the Postgres service.
DATABASE_URL=postgresql://localhost:5432/wardrobe

# TLS is off unless set. Leave empty when Postgres shares a private network with
# the app (the normal Coolify setup). Set to "require" whenever the connection
# leaves the host, or "no-verify" for a managed database with a self-signed
# certificate.
PGSSLMODE=

# --- Claude ----------------------------------------------------------------
# Leave unset locally if you are signed in with `ant auth login`; the SDK picks
# that profile up. Set it in Coolify.
ANTHROPIC_API_KEY=

# --- Files -----------------------------------------------------------------
# Where uploaded photos live. Never inside the repo in production: the Docker
# image mounts a volume at /data.
PHOTOS_DIR=./data/photos

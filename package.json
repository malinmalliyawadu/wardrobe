{
  "name": "wardrobe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "db:reset": "node --env-file-if-exists=.env scripts/migrate.ts --reset",
    "health": "node --env-file-if-exists=.env scripts/health.ts",
    "test": "node --env-file-if-exists=.env --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "next": "16.4.5",
    "postgres": "^4.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
